{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar C++",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "-o",
                "${workspaceFolder}/pizzaMasApp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}